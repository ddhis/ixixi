---
// src/components/ApAstroGoogleDocsMemo.astro
---
<div style="margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
  <span id="status" style="font-size: 0.85em; color: #64748b;">내용 불러오는 중...</span>
  <button id="copyBtn" style="padding: 6px 12px; cursor: pointer; border-radius: 6px; border: 1px solid #cbd5e1; background: #f8fafc; font-size: 0.85rem;">📋 전체 복사</button>
</div>

<textarea 
  id="memo" 
  rows="15" 
  style="
    width: 100%; 
    padding: 12px; 
    box-sizing: border-box; 
    border: 1px solid #e2e8f0; 
    border-radius: 8px; 
    outline: none; 
    resize: vertical; 
    font-size: 0.95rem; 
    line-height: 1.5;
  " 
  placeholder="여기에 메모를 입력하세요. 타이핑을 멈추면 자동으로 저장됩니다..."
></textarea>

<style>
  #memo:focus {
    border-color: #cbd5e1 !important;
    box-shadow: 0 0 0 3px rgba(226, 232, 240, 0.5);
  }
</style>

<script>
  const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyJ7riyokQ5llnnNt8OtUsueviv-e0zyUlt1MzPjLhBZn4IQNZ8VYjF__cy8X1N1jBZBg/exec";

  const memoEl = document.getElementById('memo') as HTMLTextAreaElement | null;
  const statusEl = document.getElementById('status') as HTMLElement | null;
  const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement | null;

  let saveTimer: ReturnType<typeof setTimeout> | null = null;
  let isFetching = false; // 중복 요청 방지 플래그

  // 1. 구글 문서 내용 불러오기
  async function loadMemo() {
    if (isFetching) return;
    try {
      isFetching = true;
      const res = await fetch(GOOGLE_SCRIPT_URL);
      const data = await res.json();
      
      // 입력창에 포커스가 없을 때만 내용 업데이트 (입력 중인 글자 덮어쓰기 방지)
      if (memoEl && document.activeElement !== memoEl) {
        // 서버 내용과 현재 입력창 내용이 다를 때만 갱신
        if (memoEl.value !== (data.text || "")) {
          memoEl.value = data.text || "";
          if (statusEl) statusEl.innerText = "🔄 최신 내용으로 동기화됨";
          setTimeout(() => {
            if (statusEl && statusEl.innerText.includes("동기화")) statusEl.innerText = "자동 저장 준비됨";
          }, 2000);
        }
      }
    } catch (err) {
      // 불러오기 실패 시 조용히 무시
    } finally {
      isFetching = false;
    }
  }

  // 2. 구글 문서로 저장
  async function saveMemo() {
    if (!memoEl) return;
    if (statusEl) statusEl.innerText = "저장 중...";

    try {
      await fetch(GOOGLE_SCRIPT_URL, {
        method: "POST",
        body: JSON.stringify({ text: memoEl.value })
      });
      if (statusEl) statusEl.innerText = "✨ 자동 저장 완료";
    } catch (err) {
      if (statusEl) statusEl.innerText = "❌ 저장 실패";
    }
  }

  // 3. 타이핑 입력 이벤트 (1초 뒤 자동 저장)
  if (memoEl) {
    memoEl.addEventListener('input', () => {
      if (statusEl) statusEl.innerText = "작성 중...";
      if (saveTimer) clearTimeout(saveTimer);

      saveTimer = setTimeout(() => {
        saveMemo();
      }, 1000);
    });
  }

  // 4. 복사 버튼
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      if (!memoEl || !memoEl.value) {
        alert("복사할 내용이 없습니다.");
        return;
      }
      try {
        await navigator.clipboard.writeText(memoEl.value);
        const originalText = copyBtn.innerText;
        copyBtn.innerText = "✅ 복사 완료!";
        setTimeout(() => copyBtn.innerText = originalText, 2000);
      } catch (err) {
        memoEl.select();
        document.execCommand('copy');
        alert("클립보드에 복사되었습니다!");
      }
    });
  }

  // [최초 실행] 즉시 불러오기
  loadMemo();

  // [주기적 실행] 5초마다 상대방이 변경한 내용이 있는지 자동 체크
  setInterval(() => {
    loadMemo();
  }, 5000);
</script>